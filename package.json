{
  "name": "obsidian-annotate",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "release:verify": "node scripts/release.mjs",
    "build:dev": "tsc --noEmit && node esbuild.config.mjs --dev",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node scripts/test.mjs",
    "check": "node e2e/run-macos.mjs",
    "format": "prettier --write src tests e2e scripts *.mjs *.json styles.css README.md",
    "format:check": "prettier --check src tests e2e scripts *.mjs *.json styles.css README.md",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "dev:vault": "node esbuild.config.mjs --watch --vault",
    "check:codex-tools": "node scripts/check-codex-tools.mjs",
    "check:codex-skills": "node scripts/check-codex-skills.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "dev:install": "npm run build:dev && node scripts/install-development.mjs",
    "check:full": "node e2e/run-macos.mjs --full --record",
    "check:compat": "node e2e/macos/inspect.mjs"
  },
  "dependencies": {
    "@lezer/markdown": "^1.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "obsidian": "1.14.4",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "license": "MIT",
  "author": {
    "name": "junuxyz",
    "email": "216036880+junuxyz@users.noreply.github.com"
  },
  "description": "Threaded comments on selected text in Obsidian.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/junuxyz/Annotate.git"
  }
}
